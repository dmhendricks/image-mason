# Image Mason configuration. Copy to .env and edit:
#
#   cp .env.sample .env
#
# Every setting is optional. Commented-out values show the defaults.

# --- Compose -----------------------------------------------------------------

# Host port for the API.
# PORT=8080

# Image tag to run: latest, 0.1, or 0.1.0.
# IMAGE_MASON_TAG=latest

# Development: build from the local Dockerfile instead of pulling the image.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- Container ---------------------------------------------------------------

# IANA timezone for logs and timestamps.
# TZ=UTC

# --- Access ------------------------------------------------------------------

# Callers send this in the X-Api-Key header. Empty turns authentication off.
IMAGE_MASON_API_KEY=

# Origin used in the URLs of stored images, when the service is reached through a proxy or another
# hostname. Empty uses the scheme and host of each request.
# IMAGE_MASON_PUBLIC_BASE_URL=https://images.example.com

# --- Limits ------------------------------------------------------------------

# Largest accepted image file, uploaded or fetched. Bytes, or a size such as 25m.
# IMAGE_MASON_MAX_INPUT_SIZE=25m

# Largest accepted image in pixels (width x height), read from the file header before decoding.
# IMAGE_MASON_MAX_PIXELS=50000000

# Jobs that run at once, and requests that wait for a slot before getting 503. Jobs default to the
# container's CPU count; large images also wait for memory (see IMAGE_MASON_MEMORY_LIMIT).
# IMAGE_MASON_MAX_CONCURRENT_JOBS=4
# IMAGE_MASON_MAX_QUEUED_JOBS=16

# Seconds before a request stops with 504.
# IMAGE_MASON_TIMEOUT_SECONDS=120

# Memory the service may use. Each optimization job reserves its estimated peak before it starts, and waits
# while the memory is in use; a job that could never fit gets 422. Lossy presets need about 150 MB per
# megapixel (a 12 MP photo needs about 2 GB). Empty uses the container's memory limit.
# IMAGE_MASON_MEMORY_LIMIT=4g

# --- Optimization ------------------------------------------------------------

# Downscale images wider than this. 0 keeps the original size unless a request sets maxWidth.
# IMAGE_MASON_DEFAULT_MAX_WIDTH=0

# Quality preset for requests that don't send one, and the web interface's starting choice: high, medium or low.
# IMAGE_MASON_DEFAULT_QUALITY=medium

# Minimum SSIMULACRA2 score for each quality preset (100 means identical).
# IMAGE_MASON_HIGH_MIN_SCORE=85
# IMAGE_MASON_MEDIUM_MIN_SCORE=80
# IMAGE_MASON_LOW_MIN_SCORE=70

# --- Stored Images -----------------------------------------------------------

# Minutes a stored image is served before it is deleted.
# IMAGE_MASON_IMAGE_TTL_MINUTES=60

# Soft cap on total stored size. Past it, the oldest images are deleted. 0 turns the cap off.
# IMAGE_MASON_MAX_STORE_SIZE=10g

# --- Fetching by URL (?url=) -------------------------------------------------

# false accepts uploaded images only.
# IMAGE_MASON_URL_FETCH_ENABLED=true

# Comma-separated hosts the service may fetch from. *.example.com matches any subdomain.
# Checked on every redirect. Empty allows any host.
# IMAGE_MASON_URL_ALLOWED_HOSTS=cdn.example.com,*.example.org

# Comma-separated extensions the URL path must end in. Empty allows any.
# IMAGE_MASON_URL_ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,avif,jxl

# --- Web interface -----------------------------------------------------------

# false turns the web interface off: / redirects to the usage examples at /docs. The API is unaffected.
# IMAGE_MASON_UI_ENABLED=true

# --- Logging -----------------------------------------------------------------

# Trace, Debug, Information, Warning, or Error.
# IMAGE_MASON_LOG_LEVEL=Information
