<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>image-mason</AssemblyName>
    <RootNamespace>ImageMason</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageMason.Tests" />
  </ItemGroup>

  <!-- The landing page and favicons are embedded in the binary instead of published as a web root. -->
  <PropertyGroup>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/**" LogicalName="ImageMason.wwwroot.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
