<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>image-mason</AssemblyName>
    <RootNamespace>ImageMason</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageMason.Tests" />
  </ItemGroup>

  <!-- The pages, favicons and the web interface are embedded in the binary instead of published as a web root.
       The web interface is src/web's Vite build (npm run build); without it, / serves wwwroot/no-app.html. -->
  <PropertyGroup>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../web/dist/**" LogicalName="wwwroot/app/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
