{
  "name": "image-mason-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "size": "node scripts/check-size.js"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.0",
    "sass-embedded": "^1.108.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  }
